{
  "name": "doh-worker",
  "version": "1.0.0",
  "description": "DNS-over-HTTPS (DoH) proxy on Cloudflare Workers with ECS support",
  "main": "src/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "node scripts/build.js",
    "verify:bundle": "node scripts/verify-no-compat.mjs",
    "probe:ecs": "node scripts/ecs-probe.mjs",
    "test": "vitest run"
  },
  "keywords": [
    "dns",
    "doh",
    "dns-over-https",
    "cloudflare-workers",
    "ecs"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dns-packet": "^5.6.1"
  },
  "devDependencies": {
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.118.0"
  }
}
